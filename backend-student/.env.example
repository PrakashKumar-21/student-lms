# ============================================================
#  Backend environment variables — copy to .env and fill in.
#  NEVER commit the real .env file.
# ============================================================

# ---------- Database (local Docker Postgres by default) ----------
# Inside docker-compose use host "postgres"; running natively use "localhost".
DATABASE_URL=postgresql+psycopg://lms:lms@postgres:5432/lms
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_TASK_QUEUE=ingestion

# ---------- Auth (JWT) ----------
# Generate a long random string, e.g.  openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- Default admin user ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ---------- CORS (frontend origins) ----------
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081

# ---------- OpenAI (embeddings + chat) ----------
OPENAI_API_KEY=sk-your-openai-key
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---------- RAG service (optional) ----------
RAG_API_URL=https://example.com/rag
RAG_API_KEY=dummy-rag-key

# ---------- File storage (DigitalOcean Spaces / S3 — optional) ----------
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_BUCKET=
DO_SPACES_REGION=

# ---------- SMS / Phone OTP (Twilio — optional) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------- Email OTP (SendGrid — optional) ----------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=student-lms-email

# ---------- Payments (Razorpay — optional) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- Dev flags ----------
ALLOW_CHAT_WITHOUT_SUBSCRIPTION=false
ALLOW_ADMIN_READONLY=true
